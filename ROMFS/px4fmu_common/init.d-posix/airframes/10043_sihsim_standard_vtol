#!/bin/sh
#
# @name SIH Standard VTOL
#
# @type Simulation
# @class VTOL
#
# @output Motor1 MC motor front right
# @output Motor2 MC motor back left
# @output Motor3 MC motor front left
# @output Motor4 MC motor back right
# @output Motor5 Forward thrust motor
# @output Servo1 Ailerons (single channel)
# @output Servo2 Elevator
# @output Servo3 Rudder
#
# @board px4_fmu-v2 exclude
#

. ${R}etc/init.d/rc.vtol_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=standard_vtol}

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1
param set-default SENS_EN_ARSPDSIM 1

param set-default EKF2_GPS_DELAY 0

# SET CONTORLLER TYPE AND PID GAINS
param set-default VT_TYPE 2
param set-default MPC_MAN_Y_MAX 60
param set-default MC_PITCH_P 0.5

# ROLL RATE CONTORLLER PARAMS
param set-default MC_ROLLRATE_P 0.5
param set-default MC_ROLLRATE_I 0.0
param set-default MC_ROLLRATE_D 0.0
param set-default MC_ROLLRATE_K 1.0

# ROLL CONTORLLER PARAMS
param set-default MC_ROLL_P 3.0

# PITCH RATE CONTROLLER PARAMS - TUNED FOR BETTER PITCH TRACKING
param set-default MC_PITCHRATE_P 0.8
param set-default MC_PITCHRATE_I 0.1
param set-default MC_PITCHRATE_D 0.02
param set-default MC_PITCHRATE_K 1.0

# PITCH CONTROLLER PARAMS - TUNED FOR BETTER PITCH TRACKING
param set-default MC_PITCH_P 4.0
param set-default MC_PITCH_I 0.1
param set-default MC_PITCH_D 0.02

# YAW RATE CONTROLLER PARAMS
param set-default MC_YAWRATE_P 0.6
param set-default MC_YAWRATE_I 0.1
param set-default MC_YAWRATE_D 0.0
param set-default MC_YAWRATE_K 1.0

# YAW CONTROLLER PARAMS
param set-default MC_YAW_P 2.0
param set-default MC_YAW_I 0.1
param set-default MC_YAW_D 0.0

# VELOCITY CONTROLLER PARAMS
param set-default MPC_XY_VEL_P 1.0
param set-default MPC_XY_VEL_I 0.1
param set-default MPC_XY_VEL_D 0.0
param set-default MPC_Z_VEL_P 1.0
param set-default MPC_Z_VEL_I 0.1
param set-default MPC_Z_VEL_D 0.0

# CONTROL ALLOCATION PARAMS
param set-default CA_AIRFRAME 16
param set-default CA_ROTOR_COUNT 2
# COMMENTING OUT TO HIJACK FILE FOR DUCTED DRONE
# param set-default CA_ROTOR0_KM 0.05
# param set-default CA_ROTOR0_PX 0.2
# param set-default CA_ROTOR0_PY 0.2
# param set-default CA_ROTOR1_KM 0.05
# param set-default CA_ROTOR1_PX -0.2
# param set-default CA_ROTOR1_PY -0.2
# param set-default CA_ROTOR2_PX 0.2
# param set-default CA_ROTOR2_PY -0.2
# param set-default CA_ROTOR2_KM -0.05
# param set-default CA_ROTOR3_PX -0.2
# param set-default CA_ROTOR3_PY 0.2
# param set-default CA_ROTOR3_KM -0.05
# param set-default CA_ROTOR4_PX -0.3
# param set-default CA_ROTOR4_KM 0.05
# param set-default CA_ROTOR4_AX 1
# param set-default CA_ROTOR4_AZ 0

# SIH for now hardcodes this configuration which we need to match in the airframe files.
# param set-default CA_SV_CS_COUNT 3
# param set-default CA_SV_CS0_TRQ_R 1
# param set-default CA_SV_CS0_TYPE 15  # single channel aileron
# param set-default CA_SV_CS1_TRQ_P 1
# param set-default CA_SV_CS1_TYPE 3  # elevator
# param set-default CA_SV_CS2_TRQ_Y 1
# param set-default CA_SV_CS2_TYPE 4  # rudder

param set-default FW_AIRSPD_MIN 7
param set-default FW_AIRSPD_TRIM 10
param set-default FW_AIRSPD_MAX 12

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 201
param set-default PWM_MAIN_FUNC4 202

param set-default MAV_TYPE 22

#Ducted Drone Params - L2 NORM NORMALIZED VALUES
# Control Allocation Matrix (4 actuators × 6 outputs): [Fx, Fy, Fz, Mx, My, Mz]
# Original values from SIH dynamics:
# UR: [0, 0, -0.01037, 0, 0, -0.00030]
# LR: [0, 0, -0.00967, 0, 0, 0.00030]
# S1: [-0.00185, 0.00199, 0, 0.00038, 0.00072, 0]
# S2: [-0.00280, -0.00340, 0, -0.00105, 0.00040, 0]

# L2 norm calculation:
# ||UR|| = sqrt(0^2 + 0^2 + 0.01037^2 + 0^2 + 0^2 + 0.00030^2) = 0.01037
# ||LR|| = sqrt(0^2 + 0^2 + 0.00967^2 + 0^2 + 0^2 + 0.00030^2) = 0.00968
# ||S1|| = sqrt(0.00185^2 + 0.00199^2 + 0^2 + 0.00038^2 + 0.00072^2 + 0^2) = 0.00312
# ||S2|| = sqrt(0.00280^2 + 0.00340^2 + 0^2 + 0.00105^2 + 0.00040^2 + 0^2) = 0.00454

#Rotor Params - L2 Normalized
param set-default CA_RT0_TRQ_R 0.00
param set-default CA_RT0_TRQ_P 0.00
param set-default CA_RT0_TRQ_Y -0.0289  # -0.00030 / 0.01037
param set-default CA_RT0_TX 0.00
param set-default CA_RT0_TY 0.00
param set-default CA_RT0_TZ -1.00  # -0.01037 / 0.01037

param set-default CA_RT1_TRQ_R 0.00
param set-default CA_RT1_TRQ_P 0.00
param set-default CA_RT1_TRQ_Y 0.0310  # 0.00030 / 0.00968
param set-default CA_RT1_TX 0.00
param set-default CA_RT1_TY 0.00
param set-default CA_RT1_TZ -1.00  # -0.00967 / 0.00968

# Servo Params - L2 Normalized
param set-default CA_SV_CS_COUNT 2
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS0_TRQ_R 0.1218  # 0.00038 / 0.00312
param set-default CA_SV_CS0_TRQ_P 0.2308  # 0.00072 / 0.00312
param set-default CA_SV_CS0_TRQ_Y 0.00
param set-default CA_SV_CS0_TX -0.5929  # -0.00185 / 0.00312
param set-default CA_SV_CS0_TY 0.6378  # 0.00199 / 0.00312
param set-default CA_SV_CS0_TZ 0.00

param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS1_TRQ_R -0.2313  # -0.00105 / 0.00454
param set-default CA_SV_CS1_TRQ_P 0.0881  # 0.00040 / 0.00454
param set-default CA_SV_CS1_TRQ_Y 0.00
param set-default CA_SV_CS1_TX -0.6167  # -0.00280 / 0.00454
param set-default CA_SV_CS1_TY -0.7491  # -0.00340 / 0.00454
param set-default CA_SV_CS1_TZ 0.00
# End Ducted Drone Params - L2 NORM NORMALIZED

# set SYS_HITL to 2 to start the SIH and avoid sensors startup
# param set-default SYS_HITL 2

param set-default SENS_DPRES_OFF 0.001

param set SIH_T_MAX 2.0
param set SIH_Q_MAX 0.0165
param set SIH_MASS 0.942
# IXX and IZZ are inverted from the thesis as the body frame is pitched by 90 deg
param set SIH_IXX 0.0131
param set SIH_IYY 0.0078
param set SIH_IZZ 0.0214
param set SIH_IXZ 0.0005
param set SIH_IXY 0.0005
param set SIH_IYZ -0.0008


param set SIH_KDV 0.2
param set SIH_L_ROLL 0.2

# sih as standard vtol
param set SIH_VEHICLE_TYPE 3

# ROTOR POSITIONS
param set-default CA_ROTOR0_PX 0.00
param set-default CA_ROTOR0_PY 0.00
param set-default CA_ROTOR1_PX 0.00
param set-default CA_ROTOR1_PY 0.00


# SIMULATION COMMANDS
param set-default MIS_TAKEOFF_ALT 5



